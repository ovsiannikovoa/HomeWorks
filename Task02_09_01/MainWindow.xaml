<Window x:Class="Task02_09_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task02_09_01"
        mc:Ignorable="d"
        Title="Color Viewer" Height="250" Width="300">
    <Window.CommandBindings>
        <CommandBinding Command="local:CustomCommands.ChangeColor"
                        Executed="ChangeColorExecuted"/>
        <CommandBinding Command="ApplicationCommands.Undo"
                        Executed="UndoExecuted"
                        CanExecute="UndoCanExecute"/>
    </Window.CommandBindings>
    <DockPanel x:Name="Dock">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Действия">
                <MenuItem Header="Изменить цвет"
                          Command="local:CustomCommands.ChangeColor"/>
                <MenuItem Header="Отменить"
                          Command="ApplicationCommands.Undo"/>
            </MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="Изменить цвет"
                    Command="local:CustomCommands.ChangeColor"
                    Margin="5"
                    Height="25"/>
            <Button Content="Отменить"
                    Command="ApplicationCommands.Undo"
                    Margin="5"
                    Height="25"/>
        </StackPanel>
    </DockPanel>
</Window>
