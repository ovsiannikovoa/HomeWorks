<Window x:Class="Task02_07_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task02_07_01"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="300">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Vertical" 
                                    HorizontalAlignment="Center">
                            <Grid Width="20" 
                                  Height="20" 
                                  Margin="0,0,0,5">
                                <Rectangle x:Name="rect" 
                                           RadiusX="3" 
                                           RadiusY="3" 
                                           Stroke="Black" 
                                           Fill="LightGray"/>
                                <TextBlock x:Name="checkMark" 
                                           Text="X" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           FontWeight="Bold" 
                                           Opacity="0"/>
                                <Ellipse x:Name="indeterminateMark" 
                                         Width="8" 
                                         Height="8" 
                                         Fill="Black" 
                                         HorizontalAlignment="Center" 
                                         VerticalAlignment="Center" 
                                         Opacity="0"/>
                            </Grid>
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" 
                                     Value="True">
                                <Setter TargetName="checkMark" 
                                        Property="Opacity" 
                                        Value="1"/>
                            </Trigger>

                            <Trigger Property="IsChecked" 
                                     Value="{x:Null}">
                                <Setter TargetName="indeterminateMark" 
                                        Property="Opacity" 
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Horizontal" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center">
        <CheckBox Content="UnChecked" 
                  IsChecked="False" 
                  Margin="20,0"/>

        <CheckBox Content="Checked" 
                  IsChecked="True" 
                  Margin="20,0"/>

        <CheckBox Content="Indeterminate" 
                  IsChecked="{x:Null}" 
                  Margin="20,0"/>
    </StackPanel>
</Window>
