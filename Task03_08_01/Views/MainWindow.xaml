<Window x:Class="Task03_08_01.Views.Task03_08_01View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализатор геометрии стены — Task03_08_01"
        Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Выбрать стену" Width="140" Height="34" HorizontalAlignment="Center"
                Command="{Binding SelectWallCommand}" />

        <Border Grid.Row="2" Padding="10" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Информация о стене" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Имя стены: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding WallInfo.Name}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Тип: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding WallInfo.TypeName}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="10" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Геометрические параметры" FontWeight="Bold" Margin="0,0,0,6"/>
                <UniformGrid Columns="2" Rows="5" Margin="0,6,0,0">
                    <TextBlock Text="Длина:"/>
                    <TextBlock Text="{Binding WallInfo.LengthText}" />
                    <TextBlock Text="Высота:"/>
                    <TextBlock Text="{Binding WallInfo.HeightText}" />
                    <TextBlock Text="Толщина:"/>
                    <TextBlock Text="{Binding WallInfo.ThicknessText}" />
                    <TextBlock Text="Объём:"/>
                    <TextBlock Text="{Binding WallInfo.VolumeText}" />
                    <TextBlock Text="Площадь:"/>
                    <TextBlock Text="{Binding WallInfo.AreaText}" />
                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Предел толщины (мм):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="80" Text="{Binding ThicknessLimit, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Ellipse Width="18" Height="18" Fill="{Binding WallInfo.StatusBrush}" Stroke="Black" StrokeThickness="0.5"/>
                        <TextBlock Text="{Binding WallInfo.StatusText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Закрыть" Width="90" Margin="8,0,0,0" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>