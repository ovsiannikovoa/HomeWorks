<Window x:Class="Task02_10_01.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Task02_10_01.ViewModels"
        xmlns:conv="clr-namespace:Task02_10_01.Converters"
        Title="Система входа" Height="450" Width="300">
    <Window.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Text="Форма входа" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Логин:" Margin="0,0,0,5"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox" PasswordChar="●" Margin="0,0,0,20"/>

        <Button Content="Войти" Command="{Binding LoginCommand}" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding StatusMessage}" 
                   Background="{Binding IsSuccess, Converter={StaticResource BoolToColorConverter}}"
                   Padding="10" TextAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
</Window>