<Window x:Class="Task02_03_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task02_03_01"
        mc:Ignorable="d"
        Title="Выбор курса" Height="450" Width="800">
    <StackPanel Orientation="Vertical" Height="434" VerticalAlignment="Top">
        <Label Target="{Binding ElementName=UserName}" Content="_Имя студента" />
        
        <TextBox x:Name="UserName" Margin="5" Padding="5"/>
        
        <Label Content="Факультет" />
        
        <ComboBox x:Name="Faculty" Margin="5" Padding="5" IsEditable="True" SelectedIndex="0" >
            <TextBlock>Программирование</TextBlock>
            <TextBlock>Дизайн</TextBlock>
            <TextBlock>Менеджмент</TextBlock>
        </ComboBox>
        
        <Label Content="Доступные курсы"/>
        
        <ListBox x:Name="Courses" SelectionMode="Multiple" Margin="5" Height="180">
            <ListBoxItem>Основы C#</ListBoxItem>
            <ListBoxItem>WPF</ListBoxItem>
            <ListBoxItem>Базы данных</ListBoxItem>
        </ListBox>
        
        <CheckBox x:Name="CheckBox" 
                  Content="Я согласен на обработку персональных данных" Margin="5"/>
        
        <Button x:Name="SignInButton" 
                Content="Записаться" 
                Margin="5" 
                Padding="5" 
                VerticalAlignment="Bottom"
                Click="SignInButton_Click"/>
        
    </StackPanel>
</Window>
